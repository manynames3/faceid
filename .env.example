# Leave blank for the public homepage and sample workspace.
# VITE_ values are public browser configuration. Never put AWS keys or secrets here.
VITE_API_BASE_URL=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_DOMAIN=
# Configure all three from Terraform outputs to use the authenticated AWS workspace.
# VITE_AUTH_REDIRECT_URI=http://localhost:5173
